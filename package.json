{
  "name": "boli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "check-content": "node --experimental-strip-types scripts/check-content.ts",
    "audio:texts": "esbuild scripts/export-texts.ts --bundle --platform=node --format=esm --outfile=scripts/.export.mjs --log-level=warning && node scripts/.export.mjs",
    "audio:generate": "python3 scripts/gen_audio.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
